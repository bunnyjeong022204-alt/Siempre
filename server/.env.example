# Siempre 회원가입 서버 설정. 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.

PORT=8787
# SQLite 파일 위치 (테스트는 --db 옵션으로 임시 파일을 따로 쓴다)
DB_PATH=data/siempre.db

# 프런트엔드 주소. 간편가입이 끝나면 여기로 돌아가고, OAuth redirect URI도 이 주소 기준이다.
# Vite 개발 서버가 /api를 이 서버로 넘겨 주므로 쿠키 호스트가 같아진다.
PUBLIC_BASE_URL=http://localhost:5173

# 간편가입 키. 비워 두면 해당 제공사는 시연 모드(가짜 프로필)로 동작한다.
# 제공사 콘솔에 등록할 redirect URI: PUBLIC_BASE_URL + /api/auth/{provider}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# 문자 발송 연동이 없으면 본인 인증은 시연 모드(인증번호를 응답에 담아 화면에 보여 줌)로 동작한다.
SMS_PROVIDER=
