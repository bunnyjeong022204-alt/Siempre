# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다. (이름은 shared/README.md 5장 기준)

# 공통
PORT=8787
# SQLite 파일 위치 (backend/ 기준 상대 경로 또는 file: 주소)
DATABASE_URL=data/siempre.db

# A (auth): Firebase 프로젝트 ID (웹 설정의 projectId와 같은 값). 로그인 토큰 확인에 쓴다.
# 서비스 계정 키는 필요 없다 (구글 공개 인증서로 확인).
FIREBASE_PROJECT_ID=
# 프록시 뒤에서 요청 제한에 X-Forwarded-For를 쓸 때 1
TRUST_PROXY=

# B (chat): 입점 AI별 키 (PRD 3-1)
# OPENAI_API_KEY=
