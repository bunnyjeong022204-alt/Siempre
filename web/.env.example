# 이 파일을 .env로 복사한 뒤 키를 넣으세요. 키가 없는 공급사는 데모 응답으로 동작합니다.
# .env는 Git에 올라가지 않습니다.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 라우터: rule(규칙 기반, 기본값) 또는 llm(Claude Haiku로 분류, ANTHROPIC_API_KEY 필요)
ROUTER_MODE=rule

PORT=3000
LIGHT_DAILY_LIMIT=300

# 모델 ID는 각 공급사 문서에서 확인한 값으로 바꿀 수 있습니다.
# MODEL_CLAUDE_HAIKU=claude-haiku-5-5
# MODEL_CLAUDE_SONNET=claude-sonnet-5-5
# MODEL_CLAUDE_OPUS=claude-opus-5-5
# MODEL_GPT_SOL=gpt-6-sol
# MODEL_GPT_LUNA=gpt-6-luna
# MODEL_GEMINI_FLASH=gemini-3.8-flash
# MODEL_GEMINI_ARGON=gemini-4-argon
# MODEL_GEMINI_IMAGE=gemini-3.1-flash-image
